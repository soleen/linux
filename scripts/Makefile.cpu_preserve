# SPDX-License-Identifier: GPL-2.0
#
# Build rules for compiling isolated cpu_preserved runtime objects (*.preserved.o).
# Modeled after arch/arm64/kvm/hyp/nvhe/Makefile.
#
# Usage in a subsystem Makefile:
#   preserved-obj-y += foo.preserved.o bar.preserved.o
#   include $(srctree)/scripts/Makefile.cpu_preserve
#   obj-y += $(preserved-obj-y)

PRESERVED_CFLAGS_REMOVE := $(CC_FLAGS_FTRACE) $(CC_FLAGS_SCS) $(CC_FLAGS_LTO) \
			   $(CC_FLAGS_CFI) $(PADDING_CFLAGS) $(RETPOLINE_CFLAGS) \
			   -fstack-protector -fstack-protector-strong \
			   -fprofile-sample-use=% -fprofile-use=%

PRESERVED_CFLAGS := -D__CPU_PRESERVED_RUNTIME__ -D__DISABLE_EXPORTS \
		    -D__DISABLE_TRACE_MMIO__ -D__NO_FORTIFY \
		    -fno-stack-protector -DDISABLE_BRANCH_PROFILING \
		    $(DISABLE_KSTACK_ERASE) \
		    $(DISABLE_STACKLEAK_PLUGIN) \
		    $(DISABLE_LATENT_ENTROPY_PLUGIN) \
		    $(call cc-option,-ftrivial-auto-var-init=uninitialized) \
		    $(call cc-option,-fno-jump-tables) \
		    -fno-asynchronous-unwind-tables -fno-unwind-tables

ifdef CONFIG_X86
PRESERVED_CFLAGS += $(call cc-option,-mindirect-branch=keep) \
		    $(call cc-option,-mfunction-return=keep)
endif

ifdef CONFIG_ARM64
PRESERVED_CFLAGS += $(call cc-option,-mbranch-protection=none)
endif

PRESERVED_CFLAGS += $(PRESERVED_EXTRA_CFLAGS)
PRESERVED_AFLAGS := -D__CPU_PRESERVED_RUNTIME__ -D__DISABLE_EXPORTS -UCONFIG_CFI $(PRESERVED_EXTRA_AFLAGS)

ifneq ($(strip $(preserved-obj-m)),)
$(error .preserved.o objects cannot be built into loadable modules: $(preserved-obj-m))
endif

PRESERVED_RAW_OBJS := $(patsubst %.preserved.o,%.preserved.raw.o,$(preserved-obj-y))

$(foreach o,$(PRESERVED_RAW_OBJS), \
	$(eval KASAN_SANITIZE_$(o) := n) \
	$(eval KCSAN_SANITIZE_$(o) := n) \
	$(eval KMSAN_SANITIZE_$(o) := n) \
	$(eval UBSAN_SANITIZE_$(o) := n) \
	$(eval KCOV_INSTRUMENT_$(o) := n) \
	$(eval GCOV_PROFILE_$(o) := n) \
	$(eval AUTOFDO_PROFILE_$(o) := n) \
	$(eval CFLAGS_REMOVE_$(o) += $(PRESERVED_CFLAGS_REMOVE)) \
	$(eval CFLAGS_$(o) += $(PRESERVED_CFLAGS)) \
	$(eval AFLAGS_$(o) += $(PRESERVED_AFLAGS)))

$(addprefix $(obj)/,$(PRESERVED_RAW_OBJS)): private objtool-enabled :=

$(obj)/%.preserved.raw.o: $(src)/%.c FORCE
	$(call if_changed_rule,cc_o_c)

$(obj)/%.preserved.raw.o: $(src)/%.S FORCE
	$(call if_changed_rule,as_o_S)

$(obj)/cpu_preserved.lds: $(srctree)/scripts/cpu_preserved.lds.S FORCE
	$(call if_changed_dep,cpp_lds_S)

quiet_cmd_cpu_preserved_o = PRESERVE $@
      cmd_cpu_preserved_o = \
	$(if $(filter $@,$(real-obj-m)),$(error $@: .preserved.o objects cannot be built into loadable modules)) \
	$(LD) $(ld_flags) -r -T $(obj)/cpu_preserved.lds -o $@.tmp $< && \
	$(OBJCOPY) --prefix-symbols=__cpu_preserved_ $@.tmp $@ && \
	rm -f $@.tmp

$(obj)/%.preserved.o: $(obj)/%.preserved.raw.o $(obj)/cpu_preserved.lds FORCE
	$(call if_changed,cpu_preserved_o)

targets += $(preserved-obj-y) $(PRESERVED_RAW_OBJS) cpu_preserved.lds
clean-files += $(patsubst %.preserved.o,%.preserved.o.tmp,$(preserved-obj-y))
